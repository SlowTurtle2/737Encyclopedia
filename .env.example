# Copy to .env.local and fill in. Never commit real values.
# .env* is already git-ignored.

# --- Public (safe to expose in the client bundle) ---
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR-SUPABASE-ANON-KEY"
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_XXXX"

# --- Secret (server / Supabase Edge Function only — do NOT put in the client) ---
# Set these as Supabase Edge Function secrets, not in the frontend build.
# SUPABASE_SERVICE_ROLE_KEY="..."
# STRIPE_SECRET_KEY="sk_test_XXXX"
# STRIPE_WEBHOOK_SECRET="whsec_XXXX"
# STRIPE_PRICE_ID="price_XXXX"   # the 29.99 EUR one-time price
