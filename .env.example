# Copy to .env.local and fill in. Never commit real values.
# .env* is already git-ignored.

# --- Public (safe to expose in the client bundle) ---
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR-SUPABASE-ANON-KEY"
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_XXXX"

# Stripe one-time price (public identifier, not a secret)
STRIPE_PRICE_ID="price_1UDn86RlOlNeOa53nXcsVM7C"

# --- Secret (Supabase Edge Function only — do NOT put in the client) ---
# Set these with: supabase secrets set KEY=value   (see supabase/functions/README.md)
# STRIPE_SECRET_KEY="sk_test_XXXX"
# STRIPE_WEBHOOK_SECRET="whsec_XXXX"
# SUPABASE_SERVICE_ROLE_KEY is injected automatically into Edge Functions.
